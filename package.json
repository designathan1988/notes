{
  "name": "note-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx apps/server/src/main.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "vite build && esbuild apps/server/src/main.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/main.js",
    "start": "node dist/server/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@electric-sql/pglite": "0.5.15",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/newsreader": "^5.2.8",
    "@hocuspocus/server": "4.8.0",
    "@hocuspocus/provider": "4.8.0",
    "@tiptap/core": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@tiptap/extension-collaboration": "3.33.0",
    "@tiptap/extension-collaboration-caret": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-task-list": "3.33.0",
    "@tiptap/extension-task-item": "3.33.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.6.0",
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.0",
    "pg": "^8.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "^2.17.0",
    "y-indexeddb": "^9.0.12",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.27",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.4"
  }
}
