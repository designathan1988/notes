{
  "name": "note-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx apps/server/src/main.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/main.js",
    "lint": "eslint .",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx}\" \"packages/**/*.ts\" \"tests/**/*.ts\" \"e2e/**/*.ts\" eslint.config.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "ui:shots": "node scripts/ui-shots.mjs",
    "ui:audit": "node scripts/ui-audit.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electric-sql/pglite": "0.5.15",
    "@fastify/static": "10.1.10",
    "@fastify/websocket": "^11.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hocuspocus/provider": "4.8.0",
    "@hocuspocus/server": "4.8.0",
    "@lezer/highlight": "1.2.5",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "3.33.0",
    "@tiptap/extension-collaboration": "3.33.0",
    "@tiptap/extension-collaboration-caret": "3.33.0",
    "@tiptap/extension-placeholder": "3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/extension-task-item": "3.33.0",
    "@tiptap/extension-task-list": "3.33.0",
    "@tiptap/react": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@tiptap/y-tiptap": "^3.2.0",
    "better-auth": "1.7.18",
    "d3-force": "3.0.1",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.6.0",
    "fflate": "^0.8.2",
    "lucide-react": "^0.577.0",
    "marked": "^17.0.0",
    "parse5": "8.1.1",
    "pg": "^8.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tldts": "7.4.19",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.27",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.58.0",
    "@types/d3-force": "3.0.10",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.0",
    "vitest": "5.1.0",
    "ws": "8.22.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
